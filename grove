#!/usr/bin/env bash
# grove — launch Claude Code in an isolated git worktree, inside a tmux session
#      that outlives your terminal.
#
#   grove             pick a worktree, or make one if the repo has none
#   grove -n          always make a fresh worktree
#   grove -l          list this repo's worktrees and their state
#   grove -s          list every live grove session, in any repo
#   grove -k <slug>   kill the session and remove the worktree
#   grove --hooks     print the Claude Code hook config for live status
#   grove -- <args>   pass args through to claude (e.g. grove -- --continue)
#
# A session keeps the claude binary it started with, and Claude Code moves on
# most days. Stale sessions are marked ↑<version>; opening one restarts it with
# --continue, as long as it is idle and nobody is attached.
#
# The picker has two tabs, ←/→ between them: this repo's worktrees, and every
# live grove session anywhere. Outside a git repo only the sessions tab exists.
#
# Worktrees live at <repo>/.claude/worktrees/<slug>, where Claude Code puts its
# own, so /resume finds their sessions. $GROVE_ROOT restores the old location.

set -euo pipefail

GROVE_ROOT="${GROVE_ROOT:-}"                  # set: old $GROVE_ROOT/<repo>/<slug>
GROVE_CLAUDE="${GROVE_CLAUDE:-claude}"
GROVE_PICKER="${GROVE_PICKER:-auto}"          # auto | fzf | plain
# NO_COLOR or TERM=dumb drop the colour; GROVE_ANSI=1 forces it down a pipe.

self=$(readlink -f "$0")
die() { printf 'grove: %s\n' "$*" >&2; exit 1; }
sanitize() { printf '%s' "${1//[^a-zA-Z0-9_-]/_}"; }

# --- hook entrypoint: stamp state onto the tmux session ----------------------
# Runs as a Claude Code hook, from inside the session. Must stay before any
# git work so it stays fast and never fails a hook.
if [ "${1:-}" = "--state" ]; then
  [ -n "${TMUX:-}" ] || exit 0
  tmux set-option -t "${TMUX_PANE:-}" -q @grove_state "${2:-idle}" 2>/dev/null || true
  tmux set-option -t "${TMUX_PANE:-}" -q @grove_state_at "$(date +%s)" 2>/dev/null || true
  exit 0
fi

if [ "${1:-}" = "--hooks" ]; then
  # $self is the resolved real path. Run from inside a worktree that is the
  # worktree's own copy, which `grove -k` deletes out from under the hook, so
  # prefer the name on $PATH — it outlives any one worktree.
  hook_self=$(command -v grove 2>/dev/null) || hook_self=$self
  cat <<EOF
Merge into ~/.claude/settings.json:

{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "$hook_self --state working" } ] }
    ],
    "Notification": [
      { "matcher": "permission_prompt", "hooks": [ { "type": "command", "command": "$hook_self --state waiting" } ] }
    ],
    "PreToolUse": [
      { "matcher": "AskUserQuestion", "hooks": [ { "type": "command", "command": "$hook_self --state waiting" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "$hook_self --state idle" } ] }
    ]
  }
}

Claude Code reloads hooks dynamically; no restart needed.
EOF
  exit 0
fi

# Kill one session, for the pickers' kill key. Needs no git, so it lives up
# here with the other bare-tmux entrypoints. Refuses anything that isn't ours,
# and refuses the session the picker is itself running in.
if [ "${1:-}" = "--_kill" ]; then
  s="${2:-}"
  case "$s" in grove-*) ;; *) exit 0 ;; esac
  if [ -n "${TMUX:-}" ]; then
    me=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
    [ "$s" = "$me" ] && exit 0
  fi
  tmux kill-session -t "=$s" 2>/dev/null || true
  exit 0
fi

# --- locate the main checkout, even when called from inside a worktree -------
# Outside a repo grove still runs: it just has no worktrees tab.
command -v git  >/dev/null || die "git not found"
command -v tmux >/dev/null || die "tmux not found"

in_repo=1
git_common=$(git rev-parse --git-common-dir 2>/dev/null) || in_repo=0
if [ "$in_repo" = 1 ]; then
  git_common=$(cd "$git_common" && pwd -P)
  main_root=$(dirname "$git_common")
  repo=$(basename "$main_root")
  repo_slug=$(sanitize "$repo")
  if [ -n "$GROVE_ROOT" ]; then wt_base="$GROVE_ROOT/$repo_slug"
  else                          wt_base="$main_root/.claude/worktrees"
  fi
else
  git_common='' main_root='' repo='' repo_slug='' wt_base=''
fi
need_repo() { [ "$in_repo" = 1 ] || die "not inside a git repository"; }

session_for() { printf 'grove-%s-%s' "$repo_slug" "$(sanitize "$1")"; }

# --- one tmux round-trip for every session's attach state and status ---------
# Reloaded after a kill, so the pickers never offer a session that just died.
declare -A S_ATTACHED=() S_STATE=() S_PATH=() S_CREATED=() S_CLAUDE=()
refresh_sessions() {
  local n a st cr cl p
  S_ATTACHED=() S_STATE=() S_PATH=() S_CREATED=() S_CLAUDE=()
  # @grove_claude holds a stamp, which may contain spaces but never a '|', so it
  # reads before the path rather than after it.
  while IFS='|' read -r n a st cr cl p; do
    [ -n "$n" ] || continue
    S_ATTACHED["$n"]=$a; S_STATE["$n"]=$st
    S_CREATED["$n"]=$cr; S_CLAUDE["$n"]=$cl; S_PATH["$n"]=$p
  done < <(tmux list-sessions \
    -F '#{session_name}|#{session_attached}|#{@grove_state}|#{session_created}|#{@grove_claude}|#{session_path}' \
    2>/dev/null || true)
}
refresh_sessions

alive()    { [ -n "${S_ATTACHED[$1]+x}" ]; }
attached() { [ "${S_ATTACHED[$1]:-0}" != 0 ]; }

# --- is a session running yesterday's claude? --------------------------------
# A tmux session pins the binary it launched, and Claude Code updates itself in
# the background most days, so a session left running over a weekend is stale
# the moment you come back to it. The stamp is "<mtime>.<size> <realpath>":
# the native installer swings a symlink at versions/<n.n.n>, so the path moves
# and doubles as the version label; npm and friends overwrite in place, where
# only the mtime and size move. Nothing resolvable stamps "? ?", which compares
# equal to itself forever — an unreadable claude silently turns this off.
CLAUDE_STAMP=''
claude_stamp() {
  if [ -z "$CLAUDE_STAMP" ]; then
    local p='' st=''
    if p=$(command -v "$GROVE_CLAUDE" 2>/dev/null); then
      p=$(readlink -f "$p" 2>/dev/null || printf '%s' "$p")
      st=$(stat -c '%Y.%s' "$p" 2>/dev/null || stat -f '%m.%z' "$p" 2>/dev/null) || st=''
    fi
    CLAUDE_STAMP="${st:-?} ${p:-?}"
  fi
  printf '%s' "$CLAUDE_STAMP"
}

claude_version() {  # the version on disk, or '' when the path carries no number
  local v; v=$(claude_stamp); v=${v#* }; v=${v##*/}
  case "$v" in [0-9]*.[0-9]*) printf '%s' "$v" ;; esac
}

# Unstamped means a grove too old to stamp started it: say nothing rather than
# claim every pre-existing session is stale.
stale() {
  local was=${S_CLAUDE[$1]:-}
  [ -n "$was" ] || return 1
  [ "$was" != "$(claude_stamp)" ]
}

upd_note() {  # session -> " ↑2.1.268", the version it would restart onto
  stale "$1" || return 0
  local v; v=$(claude_version)
  printf ' %s↑%s%s' "$c_ylw" "${v:-new}" "$c_rst"
}

# --- colour -----------------------------------------------------------------
# fzf is given --ansi; the plain picker prints these raw. rows() re-runs in a
# subshell for fzf's reload binding, where stdout is a pipe rather than a tty —
# that binding passes GROVE_ANSI=1 to opt back in.
if [ -n "${NO_COLOR:-}" ] || [ "${TERM:-dumb}" = dumb ] \
   || { [ -z "${GROVE_ANSI:-}" ] && [ ! -t 1 ]; }; then
  c_rst='' c_dim='' c_bold='' c_red='' c_grn='' c_ylw='' c_cyn='' c_und=''
else
  c_rst=$'\033[0m'  c_dim=$'\033[2m'  c_bold=$'\033[1m'  c_und=$'\033[4m'
  c_red=$'\033[31m' c_grn=$'\033[32m' c_ylw=$'\033[33m' c_cyn=$'\033[36m'
fi

rank_color() {  # rank -> the colour its status label wears
  case "$1" in
    0) printf '%s' "$c_bold$c_red" ;;   # needs you
    1) printf '%s' "$c_grn" ;;          # done
    2) printf '%s' "$c_cyn" ;;          # live
    4) printf '%s' "$c_ylw" ;;          # working
    *) printf '%s' "$c_dim" ;;          # free
  esac
}

# rank: lower sorts first. Sessions needing you float to the top.
status_of() {  # session -> "rank|label"
  local s=$1
  if ! alive "$s"; then printf '3|free'; return; fi
  local extra=""; attached "$s" && extra=" (attached)"
  case "${S_STATE[$s]:-}" in
    waiting) printf '0|needs you%s'  "$extra" ;;
    idle)    printf '1|done%s'       "$extra" ;;
    working) printf '4|working%s'    "$extra" ;;
    *)       printf '2|live%s'       "$extra" ;;
  esac
}

tabbar() {  # active tab -> " worktrees   sessions ", the live one lit
  local a="$1" w s
  if [ "$a" = worktrees ]; then
    w="$c_bold$c_cyn$c_und worktrees $c_rst"; s="$c_dim sessions $c_rst"
  else
    w="$c_dim worktrees $c_rst"; s="$c_bold$c_cyn$c_und sessions $c_rst"
  fi
  [ "$in_repo" = 1 ] || w=''
  printf '%s %s' "$w" "$s"
}

fmt_age() {  # seconds -> 45s / 12m / 3h07m / 2d04h
  local s=${1:-0}
  [ "$s" -lt 0 ] && s=0
  if   [ "$s" -lt 60 ];    then printf '%ds' "$s"
  elif [ "$s" -lt 3600 ];  then printf '%dm' $((s / 60))
  elif [ "$s" -lt 86400 ]; then printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60))
  else                          printf '%dd%02dh' $((s / 86400)) $((s % 86400 / 3600))
  fi
}

# What makes a worktree grove's is its branch, not its path: that ignores the
# worktrees `claude -w` now creates alongside ours, and keeps finding the ones
# left over from the old $GROVE_ROOT layout. substr, not $2 — paths hold spaces.
grove_worktrees() {
  git -C "$main_root" worktree list --porcelain 2>/dev/null \
    | awk '/^worktree /{p=substr($0,10)} /^branch refs\/heads\/grove\//{print p}' \
    | while IFS= read -r p; do
        if [ -d "$p" ]; then printf '%s\n' "$p"; fi
      done
}

path_for_slug() {
  local s="$1" p
  while IFS= read -r p; do
    if [ "$(basename "$p")" = "$s" ]; then printf '%s\n' "$p"; return 0; fi
  done < <(grove_worktrees)
  return 0
}

describe() {
  local p="$1" br dirty
  br=$(git -C "$p" symbolic-ref --short HEAD 2>/dev/null || echo detached)
  dirty=$(git -C "$p" status --porcelain 2>/dev/null | wc -l)
  if [ "$dirty" -gt 0 ]; then
    printf '%s%s%s %s~%s%s' "$c_dim" "$br" "$c_rst" "$c_ylw" "$dirty" "$c_rst"
  else
    printf '%s%s%s' "$c_dim" "$br" "$c_rst"
  fi
}

# --- machine-readable rows: display <TAB> session <TAB> path <TAB> tab -------
# The tab field is what the pickers' kill key reloads, so a kill on either tab
# comes back to the tab you were on.
rows() {
  local p slug session rank label pad
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    slug=$(basename "$p"); session=$(session_for "$slug")
    IFS='|' read -r rank label <<<"$(status_of "$session")"
    printf '%s\t%s%-10s%s  %s%-20s%s  %s\t%s\t%s\tworktrees\n' \
      "$rank" "$c_bold" "$slug" "$c_rst" "$(rank_color "$rank")" "$label" "$c_rst" \
      "$(describe "$p")$(upd_note "$session")" "$session" "$p"
  done < <(grove_worktrees) | sort -t$'\t' -k1,1n | cut -f2-
}

# grove's sessions are named grove-<repo>-<slug>, so the name minus the path's
# basename gives the repo back. A session whose worktree has since been removed
# still lists — those zombies are the main reason to want a kill key.
session_name_of() {  # session, path -> "repo/slug"
  local n="$1" p="$2" slug='' repo suffix
  [ -n "$p" ] && slug=$(basename "$p")
  repo=${n#grove-}
  suffix="-$(sanitize "$slug")"
  if [ -n "$slug" ] && [ "${repo%"$suffix"}" != "$repo" ]; then
    repo=${repo%"$suffix"}
  else
    slug=${repo##*-}; repo=${repo%-*}
  fi
  printf '%s/%s' "$repo" "$slug"
}

grove_session_names() {
  local n
  for n in "${!S_ATTACHED[@]}"; do
    case "$n" in grove-*) printf '%s\n' "$n" ;; esac
  done | sort
}

session_rows() {
  local n p name rank label cr age note now
  now=$(date +%s)
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    p=${S_PATH[$n]:-}
    name=$(session_name_of "$n" "$p")
    IFS='|' read -r rank label <<<"$(status_of "$n")"
    cr=${S_CREATED[$n]:-0}; case "$cr" in ''|*[!0-9]*) cr=$now ;; esac
    age=$(fmt_age $((now - cr)))
    if [ -n "$p" ] && [ -d "$p" ]; then note="$(describe "$p")$(upd_note "$n")"
    else                                 note="${c_red}gone${c_rst}"
    fi
    printf '%s\t%s\t%s%-24s%s  %s%-20s%s  %s%7s%s  %s\t%s\t%s\tsessions\n' \
      "$rank" "$name" \
      "$c_bold" "$name" "$c_rst" "$(rank_color "$rank")" "$label" "$c_rst" \
      "$c_dim" "$age" "$c_rst" "$note" "$n" "$p"
  done < <(grove_session_names) | sort -t$'\t' -k1,1n -k2,2 | cut -f3-
}

# The worktrees tab's last row: a synthetic entry that creates a worktree. It
# carries the %new% sentinel in its path field, so every picker path — fzf,
# cursor, numbered — recognises it by the same test. `-l` calls rows() directly
# and so never sees it; --_rows does, to survive fzf's reload binding.
NEW_SENTINEL='%new%'
new_row() {
  local slug
  printf -v slug '%-10s' '+ new'
  printf '%s%s%s  %screate a worktree%s\t%s\t%s\tworktrees\n' \
    "$c_bold$c_cyn" "$slug" "$c_rst" "$c_dim" "$c_rst" '-' "$NEW_SENTINEL"
}

# fzf reads this: line 1 is the tab bar, pinned with --header-lines=1 so a
# reload redraws it. fzf 0.38 — what Debian still ships — has no change-header,
# so the tab indicator has to ride in on the row stream.
if [ "${1:-}" = "--_rows" ]; then
  t="${2:-worktrees}"; [ "$in_repo" = 1 ] || t=sessions
  tabbar "$t"; printf '\n'
  if [ "$t" = sessions ]; then session_rows
  else rows; new_row
  fi
  exit 0
fi

# --- create a fresh worktree, race-safe against parallel shells --------------
# Keep an in-repo worktree out of git's way. info/exclude is local, so we never
# touch a tracked .gitignore; the pattern matches the one Claude Code writes.
ensure_ignored() {
  case "$wt_base" in "$main_root"/*) ;; *) return ;; esac
  local ex="$git_common/info/exclude"
  mkdir -p "$git_common/info"
  grep -qE '^\*\*/\.claude/worktrees/$|^/?\.claude/worktrees/$' "$ex" 2>/dev/null \
    || printf '**/.claude/worktrees/\n' >> "$ex"
}

new_worktree() {
  ensure_ignored
  mkdir -p "$wt_base"
  local n=1 slug path
  exec 9>"$wt_base/.lock"
  flock 9 2>/dev/null || true
  while :; do
    slug="wt$n"; path="$wt_base/$slug"
    [ ! -e "$path" ] && ! git -C "$main_root" show-ref --verify --quiet "refs/heads/grove/$slug" && break
    n=$((n + 1))
  done
  git -C "$main_root" worktree add -b "grove/$slug" "$path" >&2
  exec 9>&-
  printf '%s\n' "$path"
}

# `a && b || c` would run the attach whenever switch-client failed, so a bad
# switch from inside tmux turned into a nested-session error. Spell out the else.
attach() {
  if [ -n "${TMUX:-}" ]; then tmux switch-client  -t "=$1"
  else                        tmux attach-session -t "=$1"
  fi
}

claude_cmd() {  # claude args -> the line a pane runs
  local cmd a
  cmd=$(printf '%q' "$GROVE_CLAUDE")
  for a in "$@"; do cmd="$cmd $(printf '%q' "$a")"; done
  printf '%s; exec %s' "$cmd" "${SHELL:-/bin/bash}"   # survive /exit
}

stamp_claude() {  # record which claude this session is now running
  # set-option takes a *pane* target, so the trailing colon is load-bearing:
  # without it the call quietly does nothing, and -q swallows the error.
  tmux set-option -t "=$1:" -q @grove_claude "$(claude_stamp)" 2>/dev/null || true
}

# --- pick up a claude that updated under a running session -------------------
# Only when the restart provably costs nothing: the Stop hook says the last turn
# ended, and nobody is attached — so there is no half-typed prompt to throw away,
# and no in-flight turn to cut off. Working, waiting and unstamped (hooks not
# installed) sessions keep the binary they have and just wear the ↑ marker. The
# attached test is also what stops a picker running inside the session from
# respawning the pane it is standing in.
restartable() {
  local s=$1
  alive "$s" && stale "$s" && ! attached "$s" && [ "${S_STATE[$s]:-}" = idle ]
}

has_resume() {
  local a
  for a in "$@"; do
    case "$a" in -c|--continue|-r|--resume) return 0 ;; esac
  done
  return 1
}

# respawn-pane, not kill-session + new-session: the session survives, so this
# never trips exit-empty's shutdown race, and keeps its name, age and env.
maybe_restart() {
  local session="$1" path="$2"; shift 2
  restartable "$session" || return 0
  [ -n "$path" ] && [ -d "$path" ] || return 0
  local -a args=(${@+"$@"})
  has_resume ${args[@]+"${args[@]}"} || args=(--continue ${args[@]+"${args[@]}"})
  printf 'grove: claude %s is out — restarting %s where it left off\n' \
    "$(claude_version)" "$(basename "$path")" >&2
  if tmux respawn-pane -k -t "=$session:" -c "$path" \
       "$(claude_cmd ${args[@]+"${args[@]}"})" 2>/dev/null; then
    stamp_claude "$session"
  fi
}

launch() {
  local path="$1"; shift
  local slug session
  slug=$(basename "$path"); session=$(session_for "$slug")
  if ! alive "$session"; then
    # GROVE_SLUG/GROVE_MAIN_ROOT tell whatever runs in here that it is a grove
    # worktree, and where the main checkout is. The branch name is the weaker
    # fallback tell — it misses a detached HEAD. Only a session we create gets
    # them; an existing one is attached as it stands. tmux -e needs 3.2.
    tmux new-session -d -s "$session" -c "$path" \
      -e GROVE_SLUG="$slug" -e GROVE_MAIN_ROOT="$main_root" "$(claude_cmd "$@")"
    # A server still shutting down — exit-empty fires the moment its last session
    # dies — accepts new-session and then takes the session down with it. The
    # attach would race the corpse and the client would print a bare "[exited]",
    # which reads like grove crashed. Confirm the session before attaching.
    tmux has-session -t "=$session" 2>/dev/null \
      || die "tmux dropped the new session: $session (server restarting — try again)"
    stamp_claude "$session"
  else
    maybe_restart "$session" "$path" "$@"
  fi
  attach "$session"
}

# What every picker does with the row you chose. A sessions-tab row is always
# live, so it attaches by name — its repo is not necessarily ours, and launch()
# would name the session after the wrong one.
open_row() {
  local session="$1" path="$2"; shift 2
  if [ "$path" = "$NEW_SENTINEL" ]; then launch "$(new_worktree)" "$@"; return; fi
  if alive "$session"; then
    maybe_restart "$session" "$path" "$@"
    attach "$session"; return
  fi
  [ "$in_repo" = 1 ] || die "session is gone: $session"
  launch "$path" "$@"
}

# commits that exist only on this branch: --branches globs are relative to
# refs/heads, and plain --all would count the worktree's own HEAD, so neither
# "refs/heads/grove/$slug" nor "--all" works here.
orphan_count() {
  local slug="$1"
  git -C "$main_root" show-ref --verify --quiet "refs/heads/grove/$slug" || { printf 0; return; }
  git -C "$main_root" rev-list --count "grove/$slug" \
    --not --exclude="grove/$slug" --branches --tags --remotes 2>/dev/null || printf 0
}

cmd_kill() {
  local slug="${1:-}" path session dirty orphans risk="" ans
  [ -n "$slug" ] || die "usage: grove -k <slug>"
  case "$slug" in */*|''|.|..) die "invalid slug: $slug" ;; esac
  path=$(path_for_slug "$slug"); session=$(session_for "$slug")
  [ -n "$path" ] || die "no such worktree: $slug"

  dirty=$(git -C "$path" status --porcelain 2>/dev/null | wc -l)
  orphans=$(orphan_count "$slug")
  [ "$dirty" -gt 0 ]   && risk="$dirty uncommitted file(s)"
  if [ "$orphans" -gt 0 ]; then
    [ -n "$risk" ] && risk="$risk and "
    risk="$risk$orphans commit(s) not merged anywhere else"
  fi
  if [ -n "$risk" ]; then
    printf 'grove: %s has %s.\n' "$slug" "$risk" >&2
    [ "$orphans" -gt 0 ] && git -C "$main_root" --no-pager log --oneline -5 \
      "grove/$slug" --not --exclude="grove/$slug" --branches --tags --remotes \
      | sed 's/^/      /' >&2
    printf 'grove: delete it anyway? [y/N] ' >&2
    read -r ans </dev/tty || die "aborted"
    case "$ans" in y|Y) ;; *) exit 1 ;; esac
  fi
  alive "$session" && tmux kill-session -t "=$session"
  git -C "$main_root" worktree remove --force "$path"
  git -C "$main_root" branch -D "grove/$slug" 2>/dev/null || true
  printf 'grove: removed %s\n' "$slug" >&2
}

force_new=0
while [ $# -gt 0 ]; do
  case "$1" in
    -l|--list)     need_repo; rows | cut -f1 | sed 's/^/  /'; exit 0 ;;
    -s|--sessions) session_rows | cut -f1 | sed 's/^/  /'; exit 0 ;;
    -k|--kill)     need_repo; cmd_kill "${2:-}"; exit 0 ;;
    -n|--new)      need_repo; force_new=1; shift ;;
    -h|--help)     awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$self"; exit 0 ;;
    --)            shift; break ;;
    -*)            die "unknown option: $1 (use -- to pass flags to claude)" ;;
    *)             break ;;
  esac
done

# already inside a grove worktree? go straight to its session
if [ "$in_repo" = 1 ]; then
  here=$(git rev-parse --show-toplevel 2>/dev/null) && here=$(cd "$here" && pwd -P) \
    || here=$(pwd -P)
  if [ "$force_new" = 0 ]; then
    while IFS= read -r p; do
      if [ "$p" = "$here" ]; then launch "$p" "$@"; exit 0; fi
    done < <(grove_worktrees)
  fi
  [ "$force_new" = 1 ] && { launch "$(new_worktree)" "$@"; exit 0; }
fi

# --- tabs --------------------------------------------------------------------
# Two of them, so the arrow keys are absolute rather than a toggle: ← is always
# the worktrees tab, → always the sessions tab. Outside a repo there is only one.
TAB=worktrees
[ "$in_repo" = 1 ] || TAB=sessions

load_rows() {
  ROWS=()
  if [ "$TAB" = sessions ]; then
    mapfile -t ROWS < <(session_rows)
  else
    mapfile -t ROWS < <(rows)
    ROWS+=("$(new_row)")
  fi
}

# A repo with no worktrees at all still means "make me one" — the sessions tab
# has nothing to say about a repo you have not started work in yet.
if [ "$in_repo" = 1 ]; then
  mapfile -t ROWS < <(rows)
  [ "${#ROWS[@]}" -eq 0 ] && { launch "$(new_worktree)" "$@"; exit 0; }
  ROWS+=("$(new_row)")
else
  load_rows
  [ "${#ROWS[@]}" -eq 0 ] && { printf 'grove: no live grove sessions\n' >&2; exit 0; }
fi

# --- picker ------------------------------------------------------------------
use_fzf=0
case "$GROVE_PICKER" in
  fzf)  use_fzf=1 ;;
  auto) command -v fzf >/dev/null && [ -t 1 ] && use_fzf=1 ;;
esac

if [ "$use_fzf" = 1 ]; then
  qself=$(printf '%q' "$self")
  if [ "$in_repo" = 1 ]; then
    hint='enter open · ctrl-x kill session · ctrl-n new worktree · ←→ tabs · esc quit'
  else
    hint='enter attach · ctrl-x kill session · esc quit'
  fi
  fzf_args=(
    --ansi --delimiter='\t' --with-nth=1 --height=70% --reverse --no-multi
    --header-lines=1 --header="$c_dim$hint$c_rst"
    --preview='if [ {3} = %new% ]; then echo "make a fresh worktree and open it"; else
                 { tmux capture-pane -pe -t ={2}: 2>/dev/null || echo "(not running)"; } | tail -40; fi'
    --preview-window='right,58%,border-left'
    --bind="ctrl-x:execute-silent($qself --_kill {2})+reload(GROVE_ANSI=1 $qself --_rows {4})"
    --expect=ctrl-n
  )
  # Two tabs, so the arrows are absolute rather than a toggle, and fzf needs no
  # state of its own: ← is always worktrees, → always sessions.
  if [ "$in_repo" = 1 ]; then
    fzf_args+=(
      --bind="left:reload(GROVE_ANSI=1 $qself --_rows worktrees)+first"
      --bind="right:reload(GROVE_ANSI=1 $qself --_rows sessions)+first"
    )
  fi
  out=$({ tabbar "$TAB"; printf '\n'; printf '%s\n' "${ROWS[@]}"; } | fzf "${fzf_args[@]}") || true
  key=$(printf '%s' "$out" | head -1)
  sel=$(printf '%s' "$out" | sed -n 2p)
  [ "$key" = ctrl-n ] && [ "$in_repo" = 1 ] && { launch "$(new_worktree)" "$@"; exit 0; }
  [ -z "$sel" ] && exit 0
  open_row "$(printf '%s' "$sel" | cut -f2)" "$(printf '%s' "$sel" | cut -f3)" "$@"
  exit 0
fi

# --- plain picker: an arrow-key cursor, no deps ------------------------------
# bash's own `read -n1` switches the tty to non-canonical mode and restores it,
# so there is no stty state to save here — only the hidden cursor, which the
# traps put back on every exit path including ^C. The current row is marked with
# a pointer rather than reverse video: each row already carries its own colour
# resets, which would cancel a reverse attribute part-way along the line.
DISP=()
rebuild() {
  local r
  DISP=()
  for r in ${ROWS[@]+"${ROWS[@]}"}; do DISP+=("${r%%$'\t'*}"); done
}

FRAME=0
fline() { printf '\033[2K%s\n' "$1" >&2; FRAME=$((FRAME + 1)); }

# sets PICKED to a row index, to 'new', or to '' for quit
plain_pick() {
  local n i cur=0 k k2 k3 first=1 drawn=0 extra hint title
  PICKED=''
  show_cursor() { printf '\033[?25h' >&2; }
  exec 3</dev/tty
  trap 'show_cursor; exit 130' INT TERM
  trap 'show_cursor; exec 3<&-' RETURN
  trap show_cursor EXIT
  printf '\033[?25l' >&2

  while :; do
    n=${#DISP[@]}
    [ "$cur" -ge "$n" ] && cur=0
    [ "$first" = 1 ] && first=0 || printf '\033[%dA' "$drawn" >&2
    FRAME=0

    if [ "$TAB" = sessions ]; then
      title='grove sessions'
      hint='↑↓/jk move   enter attach   x kill session   q quit'
    else
      title="$repo"
      hint='↑↓/jk move   enter open   x kill session   n new   q quit'
    fi
    [ "$in_repo" = 1 ] && hint="$hint   ←→ tabs"

    fline ''
    fline "  $c_bold$title$c_rst"
    fline "  $(tabbar "$TAB")"
    fline "  $c_dim$hint$c_rst"
    fline ''
    if [ "$n" -eq 0 ]; then
      fline "    ${c_dim}(nothing here)$c_rst"
    else
      for i in "${!DISP[@]}"; do
        if [ "$i" = "$cur" ]; then
          fline "  $c_bold$c_cyn❯$c_rst ${DISP[$i]}"
        else
          fline "    ${DISP[$i]}"
        fi
      done
    fi

    # a shorter frame than last time leaves stale rows below: wipe the excess
    if [ "$drawn" -gt "$FRAME" ]; then
      extra=$((drawn - FRAME))
      for ((i = 0; i < extra; i++)); do printf '\033[2K\n' >&2; done
      printf '\033[%dA' "$extra" >&2
    fi
    drawn=$FRAME

    IFS= read -rsn1 k <&3 || return 0
    case "$k" in
      '')          [ "$n" -gt 0 ] && { PICKED=$cur; return 0; } ;;  # enter
      $'\033')
        # a lone ESC quits; ESC [ or ESC O starts a cursor key
        read -rsn1 -t 0.05 k2 <&3 || return 0
        case "$k2" in '['|O) ;; *) continue ;; esac
        read -rsn1 -t 0.05 k3 <&3 || continue
        case "$k3" in
          A) [ "$n" -gt 0 ] && cur=$(( (cur - 1 + n) % n )) ;;
          B) [ "$n" -gt 0 ] && cur=$(( (cur + 1) % n )) ;;
          C) switch_tab sessions && cur=0 ;;
          D) switch_tab worktrees && cur=0 ;;
          H) cur=0 ;;
          F) cur=$(( n - 1 )) ;;
        esac ;;
      k|p)         [ "$n" -gt 0 ] && cur=$(( (cur - 1 + n) % n )) ;;
      j)           [ "$n" -gt 0 ] && cur=$(( (cur + 1) % n )) ;;
      l)           switch_tab sessions  && cur=0 ;;
      h)           switch_tab worktrees && cur=0 ;;
      g)           cur=0 ;;
      G)           cur=$(( n - 1 )) ;;
      [1-9])       [ "$k" -le "$n" ] && cur=$(( k - 1 )) ;;
      x|$'\030')   [ "$n" -gt 0 ] && kill_row "$cur" ;;
      n|N)         [ "$TAB" = worktrees ] && { PICKED=new; return 0; } ;;
      q|Q|$'\003') return 0 ;;
    esac
  done
}

switch_tab() {  # true only when the tab actually changed, so the caller resets
  [ "$in_repo" = 1 ] || return 1
  [ "$TAB" = "$1" ] && return 1
  TAB=$1
  load_rows; rebuild
  return 0
}

kill_row() {
  local s
  s=$(printf '%s' "${ROWS[$1]}" | cut -f2)
  "$self" --_kill "$s" || true
  refresh_sessions; load_rows; rebuild
}

rebuild
if [ -t 2 ] && [ "${TERM:-dumb}" != dumb ] && [ -r /dev/tty ]; then
  plain_pick
  printf '\n' >&2
  case "$PICKED" in
    '')  exit 0 ;;
    new) launch "$(new_worktree)" "$@" ;;
    *)   open_row "$(printf '%s' "${ROWS[$PICKED]}" | cut -f2)" \
                  "$(printf '%s' "${ROWS[$PICKED]}" | cut -f3)" "$@" ;;
  esac
  exit 0
fi

# No usable terminal — piped stderr, or TERM=dumb. Fall back to a numbered read.
# One tab only: whichever this invocation defaulted to.
printf '\n  %s%s%s\n\n' "$c_bold" "${repo:-grove sessions}" "$c_rst" >&2
for i in "${!DISP[@]}"; do
  printf '  %d) %s\n' "$((i + 1))" "${DISP[$i]}" >&2
done
printf '  q) quit\n\n  > ' >&2
read -r choice </dev/tty
case "$choice" in
  n|N)    need_repo; launch "$(new_worktree)" "$@" ;;
  q|Q|'') exit 0 ;;
  *)
    [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#ROWS[@]}" ] \
      || die "invalid choice: $choice"
    sel=${ROWS[$((choice - 1))]}
    open_row "$(printf '%s' "$sel" | cut -f2)" "$(printf '%s' "$sel" | cut -f3)" "$@"
    ;;
esac
