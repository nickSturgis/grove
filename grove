#!/usr/bin/env bash
# grove — launch Claude Code in an isolated git worktree, inside a tmux session
#      that outlives your terminal.
#
#   grove             pick a worktree, or make one if the repo has none
#   grove -n          always make a fresh worktree
#   grove -l          list this repo's worktrees and their state
#   grove -k <slug>   kill the session and remove the worktree
#   grove --hooks     print the Claude Code hook config for live status
#   grove -- <args>   pass args through to claude (e.g. grove -- --continue)
#
# Worktrees live at <repo>/.claude/worktrees/<slug>, where Claude Code puts its
# own, so /resume finds their sessions. $GROVE_ROOT restores the old location.

set -euo pipefail

GROVE_ROOT="${GROVE_ROOT:-}"                  # set: old $GROVE_ROOT/<repo>/<slug>
GROVE_CLAUDE="${GROVE_CLAUDE:-claude}"
GROVE_PICKER="${GROVE_PICKER:-auto}"          # auto | fzf | plain
# NO_COLOR or TERM=dumb drop the colour; GROVE_ANSI=1 forces it down a pipe.

self=$(readlink -f "$0")
die() { printf 'grove: %s\n' "$*" >&2; exit 1; }
sanitize() { printf '%s' "${1//[^a-zA-Z0-9_-]/_}"; }

# --- hook entrypoint: stamp state onto the tmux session ----------------------
# Runs as a Claude Code hook, from inside the session. Must stay before any
# git work so it stays fast and never fails a hook.
if [ "${1:-}" = "--state" ]; then
  [ -n "${TMUX:-}" ] || exit 0
  tmux set-option -t "${TMUX_PANE:-}" -q @grove_state "${2:-idle}" 2>/dev/null || true
  tmux set-option -t "${TMUX_PANE:-}" -q @grove_state_at "$(date +%s)" 2>/dev/null || true
  exit 0
fi

if [ "${1:-}" = "--hooks" ]; then
  cat <<EOF
Merge into ~/.claude/settings.json:

{
  "hooks": {
    "UserPromptSubmit": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "$self --state working" } ] }
    ],
    "Notification": [
      { "matcher": "permission_prompt", "hooks": [ { "type": "command", "command": "$self --state waiting" } ] }
    ],
    "PreToolUse": [
      { "matcher": "AskUserQuestion", "hooks": [ { "type": "command", "command": "$self --state waiting" } ] }
    ],
    "Stop": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "$self --state idle" } ] }
    ]
  }
}

Claude Code reloads hooks dynamically; no restart needed.
EOF
  exit 0
fi

# --- locate the main checkout, even when called from inside a worktree -------
command -v git  >/dev/null || die "git not found"
command -v tmux >/dev/null || die "tmux not found"

git_common=$(git rev-parse --git-common-dir 2>/dev/null) || die "not inside a git repository"
git_common=$(cd "$git_common" && pwd -P)
main_root=$(dirname "$git_common")
repo=$(basename "$main_root")
repo_slug=$(sanitize "$repo")
if [ -n "$GROVE_ROOT" ]; then wt_base="$GROVE_ROOT/$repo_slug"
else                          wt_base="$main_root/.claude/worktrees"
fi

session_for() { printf 'grove-%s-%s' "$repo_slug" "$(sanitize "$1")"; }

# --- one tmux round-trip for every session's attach state and status ---------
declare -A S_ATTACHED=() S_STATE=()
while IFS='|' read -r n a st; do
  [ -n "$n" ] || continue
  S_ATTACHED["$n"]=$a
  S_STATE["$n"]=$st
done < <(tmux list-sessions -F '#{session_name}|#{session_attached}|#{@grove_state}' 2>/dev/null || true)

alive()    { [ -n "${S_ATTACHED[$1]+x}" ]; }
attached() { [ "${S_ATTACHED[$1]:-0}" != 0 ]; }

# --- colour -----------------------------------------------------------------
# fzf is given --ansi; the plain picker prints these raw. rows() re-runs in a
# subshell for fzf's reload binding, where stdout is a pipe rather than a tty —
# that binding passes GROVE_ANSI=1 to opt back in.
if [ -n "${NO_COLOR:-}" ] || [ "${TERM:-dumb}" = dumb ] \
   || { [ -z "${GROVE_ANSI:-}" ] && [ ! -t 1 ]; }; then
  c_rst='' c_dim='' c_bold='' c_red='' c_grn='' c_ylw='' c_cyn=''
else
  c_rst=$'\033[0m'  c_dim=$'\033[2m'  c_bold=$'\033[1m'
  c_red=$'\033[31m' c_grn=$'\033[32m' c_ylw=$'\033[33m' c_cyn=$'\033[36m'
fi

rank_color() {  # rank -> the colour its status label wears
  case "$1" in
    0) printf '%s' "$c_bold$c_red" ;;   # needs you
    1) printf '%s' "$c_grn" ;;          # done
    2) printf '%s' "$c_cyn" ;;          # live
    4) printf '%s' "$c_ylw" ;;          # working
    *) printf '%s' "$c_dim" ;;          # free
  esac
}

# rank: lower sorts first. Sessions needing you float to the top.
status_of() {  # session -> "rank|label"
  local s=$1
  if ! alive "$s"; then printf '3|free'; return; fi
  local extra=""; attached "$s" && extra=" (attached)"
  case "${S_STATE[$s]:-}" in
    waiting) printf '0|needs you%s'  "$extra" ;;
    idle)    printf '1|done%s'       "$extra" ;;
    working) printf '4|working%s'    "$extra" ;;
    *)       printf '2|live%s'       "$extra" ;;
  esac
}

# What makes a worktree grove's is its branch, not its path: that ignores the
# worktrees `claude -w` now creates alongside ours, and keeps finding the ones
# left over from the old $GROVE_ROOT layout. substr, not $2 — paths hold spaces.
grove_worktrees() {
  git -C "$main_root" worktree list --porcelain 2>/dev/null \
    | awk '/^worktree /{p=substr($0,10)} /^branch refs\/heads\/grove\//{print p}' \
    | while IFS= read -r p; do
        if [ -d "$p" ]; then printf '%s\n' "$p"; fi
      done
}

path_for_slug() {
  local s="$1" p
  while IFS= read -r p; do
    if [ "$(basename "$p")" = "$s" ]; then printf '%s\n' "$p"; return 0; fi
  done < <(grove_worktrees)
  return 0
}

describe() {
  local p="$1" br dirty
  br=$(git -C "$p" symbolic-ref --short HEAD 2>/dev/null || echo detached)
  dirty=$(git -C "$p" status --porcelain 2>/dev/null | wc -l)
  if [ "$dirty" -gt 0 ]; then
    printf '%s%s%s %s~%s%s' "$c_dim" "$br" "$c_rst" "$c_ylw" "$dirty" "$c_rst"
  else
    printf '%s%s%s' "$c_dim" "$br" "$c_rst"
  fi
}

# --- machine-readable rows: display <TAB> session <TAB> path ------------------
rows() {
  local p slug session rank label
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    slug=$(basename "$p"); session=$(session_for "$slug")
    IFS='|' read -r rank label <<<"$(status_of "$session")"
    printf '%s\t%s%-10s%s  %s%-20s%s  %s\t%s\t%s\n' \
      "$rank" "$c_bold" "$slug" "$c_rst" "$(rank_color "$rank")" "$label" "$c_rst" \
      "$(describe "$p")" "$session" "$p"
  done < <(grove_worktrees) | sort -t$'\t' -k1,1n | cut -f2-
}

# The picker's last row: a synthetic entry that creates a worktree. It carries
# the %new% sentinel in its path field, so every picker path — fzf, cursor,
# numbered — recognises it by the same test. `-l` calls rows() directly and so
# never sees it; --_rows does, to survive fzf's reload binding.
NEW_SENTINEL='%new%'
new_row() {
  local slug
  printf -v slug '%-10s' '+ new'
  printf '%s%s%s  %screate a worktree%s\t%s\t%s\n' \
    "$c_bold$c_cyn" "$slug" "$c_rst" "$c_dim" "$c_rst" '-' "$NEW_SENTINEL"
}
[ "${1:-}" = "--_rows" ] && { rows; new_row; exit 0; }

# --- create a fresh worktree, race-safe against parallel shells --------------
# Keep an in-repo worktree out of git's way. info/exclude is local, so we never
# touch a tracked .gitignore; the pattern matches the one Claude Code writes.
ensure_ignored() {
  case "$wt_base" in "$main_root"/*) ;; *) return ;; esac
  local ex="$git_common/info/exclude"
  mkdir -p "$git_common/info"
  grep -qE '^\*\*/\.claude/worktrees/$|^/?\.claude/worktrees/$' "$ex" 2>/dev/null \
    || printf '**/.claude/worktrees/\n' >> "$ex"
}

new_worktree() {
  ensure_ignored
  mkdir -p "$wt_base"
  local n=1 slug path
  exec 9>"$wt_base/.lock"
  flock 9 2>/dev/null || true
  while :; do
    slug="wt$n"; path="$wt_base/$slug"
    [ ! -e "$path" ] && ! git -C "$main_root" show-ref --verify --quiet "refs/heads/grove/$slug" && break
    n=$((n + 1))
  done
  git -C "$main_root" worktree add -b "grove/$slug" "$path" >&2
  exec 9>&-
  printf '%s\n' "$path"
}

launch() {
  local path="$1"; shift
  local slug session cmd
  slug=$(basename "$path"); session=$(session_for "$slug")
  if ! alive "$session"; then
    cmd=$(printf '%q' "$GROVE_CLAUDE")
    for a in "$@"; do cmd="$cmd $(printf '%q' "$a")"; done
    cmd="$cmd; exec ${SHELL:-/bin/bash}"          # survive /exit
    tmux new-session -d -s "$session" -c "$path" "$cmd"
  fi
  [ -n "${TMUX:-}" ] && tmux switch-client -t "=$session" || tmux attach-session -t "=$session"
}

# commits that exist only on this branch: --branches globs are relative to
# refs/heads, and plain --all would count the worktree's own HEAD, so neither
# "refs/heads/grove/$slug" nor "--all" works here.
orphan_count() {
  local slug="$1"
  git -C "$main_root" show-ref --verify --quiet "refs/heads/grove/$slug" || { printf 0; return; }
  git -C "$main_root" rev-list --count "grove/$slug" \
    --not --exclude="grove/$slug" --branches --tags --remotes 2>/dev/null || printf 0
}

cmd_kill() {
  local slug="${1:-}" path session dirty orphans risk="" ans
  [ -n "$slug" ] || die "usage: grove -k <slug>"
  case "$slug" in */*|''|.|..) die "invalid slug: $slug" ;; esac
  path=$(path_for_slug "$slug"); session=$(session_for "$slug")
  [ -n "$path" ] || die "no such worktree: $slug"

  dirty=$(git -C "$path" status --porcelain 2>/dev/null | wc -l)
  orphans=$(orphan_count "$slug")
  [ "$dirty" -gt 0 ]   && risk="$dirty uncommitted file(s)"
  if [ "$orphans" -gt 0 ]; then
    [ -n "$risk" ] && risk="$risk and "
    risk="$risk$orphans commit(s) not merged anywhere else"
  fi
  if [ -n "$risk" ]; then
    printf 'grove: %s has %s.\n' "$slug" "$risk" >&2
    [ "$orphans" -gt 0 ] && git -C "$main_root" --no-pager log --oneline -5 \
      "grove/$slug" --not --exclude="grove/$slug" --branches --tags --remotes \
      | sed 's/^/      /' >&2
    printf 'grove: delete it anyway? [y/N] ' >&2
    read -r ans </dev/tty || die "aborted"
    case "$ans" in y|Y) ;; *) exit 1 ;; esac
  fi
  alive "$session" && tmux kill-session -t "=$session"
  git -C "$main_root" worktree remove --force "$path"
  git -C "$main_root" branch -D "grove/$slug" 2>/dev/null || true
  printf 'grove: removed %s\n' "$slug" >&2
}

force_new=0
while [ $# -gt 0 ]; do
  case "$1" in
    -l|--list) rows | cut -f1 | sed 's/^/  /'; exit 0 ;;
    -k|--kill) cmd_kill "${2:-}"; exit 0 ;;
    -n|--new)  force_new=1; shift ;;
    -h|--help) sed -n '2,13p' "$self" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --)        shift; break ;;
    -*)        die "unknown option: $1 (use -- to pass flags to claude)" ;;
    *)         break ;;
  esac
done

# already inside a grove worktree? go straight to its session
here=$(git rev-parse --show-toplevel 2>/dev/null) && here=$(cd "$here" && pwd -P) \
  || here=$(pwd -P)
if [ "$force_new" = 0 ]; then
  while IFS= read -r p; do
    if [ "$p" = "$here" ]; then launch "$p" "$@"; exit 0; fi
  done < <(grove_worktrees)
fi

[ "$force_new" = 1 ] && { launch "$(new_worktree)" "$@"; exit 0; }

mapfile -t ROWS < <(rows)
[ "${#ROWS[@]}" -eq 0 ] && { launch "$(new_worktree)" "$@"; exit 0; }
ROWS+=("$(new_row)")

# a picked row's path, with the synthetic row turned into a real worktree
resolve() { if [ "$1" = "$NEW_SENTINEL" ]; then new_worktree; else printf '%s\n' "$1"; fi; }

# --- picker ------------------------------------------------------------------
use_fzf=0
case "$GROVE_PICKER" in
  fzf)  use_fzf=1 ;;
  auto) command -v fzf >/dev/null && [ -t 1 ] && use_fzf=1 ;;
esac

if [ "$use_fzf" = 1 ]; then
  out=$(printf '%s\n' "${ROWS[@]}" | fzf \
    --ansi --delimiter='\t' --with-nth=1 --height=70% --reverse --no-multi \
    --header=$'enter open   ctrl-x kill   ctrl-n new worktree   esc quit\n' \
    --preview='if [ {3} = %new% ]; then echo "make a fresh worktree and open it"; else
                 { tmux capture-pane -pe -t ={2}: 2>/dev/null || echo "(not running)"; } | tail -40; fi' \
    --preview-window='right,58%,border-left' \
    --bind="ctrl-x:execute-silent(tmux kill-session -t ={2} 2>/dev/null)+reload(GROVE_ANSI=1 $(printf '%q' "$self") --_rows)" \
    --expect=ctrl-n) || true
  key=$(printf '%s' "$out" | head -1)
  sel=$(printf '%s' "$out" | sed -n 2p)
  [ "$key" = ctrl-n ] && { launch "$(new_worktree)" "$@"; exit 0; }
  [ -z "$sel" ] && exit 0
  launch "$(resolve "$(printf '%s' "$sel" | cut -f3)")" "$@"
  exit 0
fi

# --- plain picker: an arrow-key cursor, no deps ------------------------------
# bash's own `read -n1` switches the tty to non-canonical mode and restores it,
# so there is no stty state to save here — only the hidden cursor, which the
# traps put back on every exit path including ^C. The current row is marked with
# a pointer rather than reverse video: each row already carries its own colour
# resets, which would cancel a reverse attribute part-way along the line.
plain_pick() {   # sets PICKED to a row index, to 'new', or to '' for quit
  local n=${#DISP[@]} i cur=0 k k2 k3 first=1
  PICKED=''
  show_cursor() { printf '\033[?25h' >&2; }
  exec 3</dev/tty
  trap 'show_cursor; exit 130' INT TERM
  trap 'show_cursor; exec 3<&-' RETURN
  trap show_cursor EXIT
  printf '\033[?25l' >&2

  while :; do
    # after the first pass, rewind over exactly the rows we drew
    [ "$first" = 1 ] && first=0 || printf '\033[%dA' "$n" >&2
    for i in "${!DISP[@]}"; do
      if [ "$i" = "$cur" ]; then
        printf '\033[2K  %s\xe2\x9d\xaf%s %s\n' "$c_bold$c_cyn" "$c_rst" "${DISP[$i]}" >&2
      else
        printf '\033[2K    %s\n' "${DISP[$i]}" >&2
      fi
    done

    IFS= read -rsn1 k <&3 || return 0
    case "$k" in
      '')          PICKED=$cur; return 0 ;;   # enter — read strips the newline
      $'\033')
        # a lone ESC quits; ESC [ or ESC O starts a cursor key
        read -rsn1 -t 0.05 k2 <&3 || return 0
        case "$k2" in '['|O) ;; *) continue ;; esac
        read -rsn1 -t 0.05 k3 <&3 || continue
        case "$k3" in
          A) cur=$(( (cur - 1 + n) % n )) ;;
          B) cur=$(( (cur + 1) % n )) ;;
          H) cur=0 ;;
          F) cur=$(( n - 1 )) ;;
        esac ;;
      k|p)         cur=$(( (cur - 1 + n) % n )) ;;
      j)           cur=$(( (cur + 1) % n )) ;;
      g)           cur=0 ;;
      G)           cur=$(( n - 1 )) ;;
      [1-9])       [ "$k" -le "$n" ] && cur=$(( k - 1 )) ;;
      n|N)         PICKED=new; return 0 ;;
      q|Q|$'\003') return 0 ;;
    esac
  done
}

DISP=()
for r in "${ROWS[@]}"; do DISP+=("${r%%$'\t'*}"); done

printf '\n  %s%s%s \xe2\x80\x94 pick a worktree\n' "$c_bold" "$repo" "$c_rst" >&2
printf '  %s\xe2\x86\x91\xe2\x86\x93/jk move   enter open   n new   q quit%s\n\n' \
  "$c_dim" "$c_rst" >&2

if [ -t 2 ] && [ "${TERM:-dumb}" != dumb ] && [ -r /dev/tty ]; then
  plain_pick
  printf '\n' >&2
  case "$PICKED" in
    '')  exit 0 ;;
    new) launch "$(new_worktree)" "$@" ;;
    *)   launch "$(resolve "$(printf '%s' "${ROWS[$PICKED]}" | cut -f3)")" "$@" ;;
  esac
  exit 0
fi

# No usable terminal — piped stderr, or TERM=dumb. Fall back to a numbered read.
for i in "${!DISP[@]}"; do
  printf '  %d) %s\n' "$((i + 1))" "${DISP[$i]}" >&2
done
printf '  q) quit\n\n  > ' >&2
read -r choice </dev/tty
case "$choice" in
  n|N)    launch "$(new_worktree)" "$@" ;;
  q|Q|'') exit 0 ;;
  *)
    [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#ROWS[@]}" ] \
      || die "invalid choice: $choice"
    launch "$(resolve "$(printf '%s' "${ROWS[$((choice - 1))]}" | cut -f3)")" "$@"
    ;;
esac
